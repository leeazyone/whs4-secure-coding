# 이 파일을 .env로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
#
# .env는 .gitignore에 등록되어 있습니다. 절대 커밋하지 마세요.
# 베이스 코드는 SECRET_KEY='secret!'를 소스에 하드코딩해 공개 저장소에
# 그대로 노출했고, 이는 세션 위조를 통한 임의 계정 탈취로 이어집니다.

# 세션 쿠키 서명 키 (필수). 아래 명령으로 생성하세요:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite 파일 경로
DATABASE=market.db

# 관리자 계정. ADMIN_PASSWORD를 비워두면 최초 실행 시 임의 생성되어
# 콘솔에 1회만 출력됩니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 개발 중에만 1로. 운영에서 1이면 Werkzeug 디버거가 열려 RCE 위험이 있습니다.
FLASK_DEBUG=0

# HTTPS로 서비스할 때 1. 세션 쿠키에 Secure 플래그가 붙습니다.
# 로컬 HTTP 환경에서 1로 두면 쿠키가 전송되지 않아 로그인이 불가능합니다.
HTTPS_ONLY=0

HOST=127.0.0.1
PORT=5000

# Socket.IO 연결을 허용할 출처 (쉼표 구분).
# ngrok 등으로 외부 노출 시 해당 주소를 추가하세요.
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
